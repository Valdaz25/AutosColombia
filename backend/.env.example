# Ejemplos: completa backend/.env con tus datos locales. No publiques ese archivo.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=CAMBIAR_BASE_DE_DATOS
DB_USER=CAMBIAR_USUARIO
DB_PASSWORD=CAMBIAR_PASSWORD
DB_CONNECT_TIMEOUT=5
# Genera una clave propia con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CAMBIAR_CLAVE_SECRETA
JWT_ACCESS_TOKEN_MINUTES=30
